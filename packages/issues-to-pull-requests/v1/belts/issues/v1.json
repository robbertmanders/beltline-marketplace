          },
          "tone" : "problem",
          "when" : "checksFailed"
        },
        {
          "id" : "6FDC7593-E4D8-4535-904D-77AA2F1BBE25",
          "name" : "has conflicts",
          "then" : {
            "do" : "route",
            "max" : 2,
            "route" : "conflicts"
          },
          "tone" : "problem",
          "when" : "conflicted"
        },
        {
          "id" : "E4B07419-B87C-476E-9D56-D9C3E05526FB",
          "name" : "is behind",
          "then" : {
            "do" : "route",
            "max" : 2,
            "route" : "conflicts"
          },
          "tone" : "problem",
          "when" : "behind"
        },
        {
          "id" : "14E72B29-3A66-450E-B5F0-DC953E13AD3A",
          "name" : "is approved",
          "then" : {
            "do" : "hold"
          },
          "tone" : "good",
          "when" : "approved"
        },
        {
          "id" : "FF159775-DA9A-40A4-8ACD-08E182AD9B9B",
          "name" : "a reviewer commented",
          "then" : {
            "do" : "hold"
          },
          "tone" : "problem",
          "when" : "commented"
        },
        {
          "id" : "B3FFAE52-F1DF-4D30-BBF1-51407579004D",
          "name" : "changes requested",
          "then" : {
            "do" : "hold"
          },
          "tone" : "problem",
          "when" : "changesRequested"
        },
        {
          "id" : "E7D083CD-61CF-43B2-900E-95F8752926E8",
          "name" : "new changes",
          "then" : {
            "do" : "hold"
          },
          "tone" : "you",
          "when" : "newChanges"
        }
      ],
      "slots" : 2,
      "type" : "watch",
      "workspace" : "readOnly",
      "writes" : "pull request"
    },
    {
      "agent" : {
        "id" : "wrap-up",
        "version" : 1
      },
      "brief" : "",
      "fallback" : "hold",
      "id" : "wrap-up",
      "model" : "openrouter/stealth/space-bunny-alpha",
      "name" : "Wrap up",
      "outcomes" : [
        {
          "id" : "2FF3C3BE-03F5-4E6D-8186-1BF7115C4C1B",
          "name" : "done",
          "then" : {
            "do" : "next"
          },
          "tone" : "good",
          "when" : "What the work was about is closed or moved on."
        },
        {
          "id" : "728546A3-EBFC-4CCB-AEE6-430585158658",
          "name" : "blocked",
          "then" : {
            "do" : "hold"
          },
          "tone" : "you",
          "when" : "It can't be closed or moved without a person."
        }
      ],
      "route" : "merged",
      "runner" : "pi",
      "slots" : 2,
      "type" : "agent",
      "workspace" : "readOnly",
      "writes" : "wrap-up.md"
    },
    {
      "agent" : {
        "id" : "resolve-conflicts",
        "version" : 1
      },
      "brief" : "",
      "fallback" : "hold",
      "id" : "resolve-conflicts",
      "model" : "openrouter/stealth/space-bunny-alpha",
      "name" : "Resolve conflicts",
      "outcomes" : [
        {
          "id" : "3C3BC5E1-0C52-4D33-A527-D65E4398C7E2",
          "name" : "resolved",
          "then" : {
            "do" : "goto",
            "to" : "watch"
          },
          "tone" : "good",
