        },
        {
          "id" : "1F09A9C2-E977-4E1A-A5AC-EEB879F3ACC3",
          "name" : "blocked",
          "then" : {
            "do" : "hold"
          },
          "tone" : "you",
          "when" : "A conflict can't be resolved without a decision from a person."
        }
      ],
      "route" : "conflicts",
      "runner" : "pi",
      "slots" : 1,
      "type" : "agent",
      "workspace" : "worktree",
      "writes" : "conflicts.md"
    },
    {
      "agent" : {
        "id" : "fix-checks",
        "version" : 1
      },
      "brief" : "",
      "fallback" : "hold",
      "id" : "fix-checks",
      "model" : "openrouter/stealth/space-bunny-alpha",
      "name" : "Fix checks",
      "outcomes" : [
        {
          "id" : "FAD68A03-E15C-4502-A9FA-6CE414062E2A",
          "name" : "fixed",
          "then" : {
