            "to" : "watch"
          },
          "tone" : "good",
          "when" : "The failing checks pass locally and the fix is pushed."
        },
        {
          "id" : "C25A7B8E-E4A8-4A41-AEED-220F302ED9D0",
          "name" : "not ours",
          "then" : {
            "do" : "hold"
          },
          "tone" : "you",
