        {
          "id" : "FAEC13BF-2814-4887-BB82-95D2AC8E2BE8",
          "name" : "blocked",
          "then" : {
            "do" : "hold"
          },
          "tone" : "you",
          "when" : "It can't be fixed without a decision from a person."
        }
